{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "outDir": "dist",
    "types": ["node"], "declaration": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "browser/**/*.ts", "hardhat.config.ts", "playwright.config.ts"]
}
