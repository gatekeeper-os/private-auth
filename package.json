{
  "name": "@gatekeeper-os/private-auth",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Private, request-bound agent authorization using Semaphore and an Ethereum permission registry",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:serve": "tsx scripts/serve-demo.ts",
    "artifacts:fetch": "tsx scripts/fetch-artifacts.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "dashboard": "tsx scripts/start-dashboard.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "@semaphore-protocol/proof": "4.14.3",
    "ethers": "6.17.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "hardhat": "3.19.0",
    "solc": "0.8.37",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "ws": "8.22.0",
    "underscore": "1.13.8",
    "snarkjs": "0.7.6",
    "tmp": "0.2.7"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
